Bootstrap: docker
From: ubuntu:22.04

%post
	# Install GNU C/C++, Make -> compile the benchmark source code
	# Install wget, tar -> download and extract
	# Install libopenmpi-dev & openmpi-bin -> onstalls Open MPI + development headers needed to compile applications against it.
    apt-get update 
    apt-get install -y build-essential wget tar openmpi-bin libopenmpi-dev
    
    # Download and install OSU Micro-Benchmarks
    cd /opt
    wget https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-7.5.2.tar.gz
    tar -xvf osu-micro-benchmarks-7.5.2.tar.gz
    cd osu-micro-benchmarks-7.5.2
    ./configure CC=mpicc CXX=mpicxx
    make
    make install
    
    # Clean up
    rm -f /opt/osu-micro-benchmarks-7.5.2.tar.gz
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/osu-micro-benchmarks-7.5.2/c/mpi/pt2pt/standard:$PATH
    export PATH=/opt/osu-micro-benchmarks-7.5.2/c/mpi/collective/blocking:$PATH
