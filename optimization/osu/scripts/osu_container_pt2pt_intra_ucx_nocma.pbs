#!/bin/bash
#PBS -N osu_container_pt2pt_intra_ucx_nocma
#PBS -l walltime=02:05:00
#PBS -l place=excl
#PBS -q normal
#PBS -P personal-haiyen02
#PBS -j oe
#PBS -o logs/osu_container_pt2pt_intra_ucx_nocma.out

# Follow-up to osu_container_pt2pt_intra_ucx.pbs, which CRASHED (exit 134) on
# both latency and bandwidth: UCX's rendezvous (zero-copy) protocol invokes
# CMA (process_vm_readv) once a message crosses its size threshold, and
# Apptainer's user-namespace isolation blocks that syscall outright --
# "Operation not permitted", not merely slow. This is the exact same CMA
# breakage the baseline already works around for vader via
# `--mca btl_vader_single_copy_mechanism none`; UCX needs the equivalent
# exclusion, `-x UCX_TLS=^cma`, which is the standard documented fix for this
# well-known Apptainer/Singularity + UCX interaction.
#
#   baseline        : --mca btl vader,self --mca btl_vader_single_copy_mechanism none
#   ucx (crashed)   : --mca pml ucx                      (CMA path -> SIGABRT beyond ~8-16 KiB)
#   ucx (this script): --mca pml ucx -x UCX_TLS=^cma      (CMA excluded, falls back to sysv/posix shared memory)

cd "$PBS_O_WORKDIR"

module purge
module load libfabric/1.11.0.4.125
module load openmpi/4.1.2-hpe
module load apptainer

SIF=$HOME/scratch/fyp/container/osu/osu_micro_benchmarks.sif
OSU_DIR=/opt/osu-micro-benchmarks-8.0rc/install/libexec/osu-micro-benchmarks/mpi/pt2pt

: "${BENCH:?Must pass -v BENCH=<latency|bw>}"
: "${REPS:?Must pass -v REPS=<number>}"

BIN="${OSU_DIR}/osu_${BENCH}"
apptainer exec "$SIF" sh -c "test -x $BIN" \
    || { echo "FATAL: $BIN not found inside $SIF"; exit 1; }

NP=2
NODE_COUNT=1
ACTUAL_NODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$ACTUAL_NODES" -ne "$NODE_COUNT" ]; then
    echo "FATAL: Expected $NODE_COUNT node, PBS granted $ACTUAL_NODES."
    exit 1
fi

REPORT_DIR="container_ucx_intra_nocma/${BENCH}"
mkdir -p "$REPORT_DIR" logs

# Only addition vs the crashed script: UCX_TLS=^cma excludes the CMA
# transport, leaving sysv/posix shared memory for intra-node and rc_mlx5 for
# (unused here) inter-node. Same pinning as the baseline vader script.
MPI_CONFIG=(
  -np "$NP"
  --map-by core --bind-to core
  --mca pml ucx
  --mca orte_base_help_aggregate 0
  -x UCX_TLS=^cma
  -x UCX_LOG_LEVEL=ERROR
)

echo "================================================================="
echo " OPTIMIZED (UCX, CMA excluded) container intra-node pt2pt: BENCH=$BENCH REPS=$REPS "
echo "================================================================="
sort -u "$PBS_NODEFILE" > "${REPORT_DIR}/nodes.txt"
cat "${REPORT_DIR}/nodes.txt"

echo "=== transport actually used (UCX_LOG_LEVEL=info, 1 rep) ==="
mpirun -np 2 --map-by core --bind-to core --mca pml ucx -x UCX_TLS=^cma -x UCX_LOG_LEVEL=info \
  apptainer exec "$SIF" "$BIN" -m 1:1 > "${REPORT_DIR}/transport_raw.txt" 2>&1
grep -iE 'selected transport|support_level|rc_verbs|ud_verbs|cma|knem|sysv|posix|mm/|tcp' \
  "${REPORT_DIR}/transport_raw.txt" | head -12 | tee "${REPORT_DIR}/transport.txt"

for REP in $(seq 1 "$REPS"); do
    echo "--- Repetition ${REP}/${REPS} ---"
    OUT="${REPORT_DIR}/osu_${BENCH}_rep${REP}.txt"
    set -x
    mpirun "${MPI_CONFIG[@]}" apptainer exec "$SIF" "$BIN" > "$OUT" 2>&1
    RC=$?
    set +x
    if [ "$RC" -ne 0 ]; then
        echo "FAILED: BENCH=$BENCH rep=$REP (exit $RC)"
        sed 's/^/    /' "$OUT" | head -20
        exit "$RC"
    fi
    rows=$(grep -cE '^[0-9]' "$OUT")
    if [ "$rows" -lt 2 ]; then
        echo "FATAL: $OUT has only $rows data rows"
        exit 1
    fi
    echo "  ok: $rows message sizes recorded"
done

echo " OPTIMIZED (CMA excluded) container intra-node pt2pt ($BENCH) Completed Successfully! "
