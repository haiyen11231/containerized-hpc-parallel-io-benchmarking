#!/bin/bash
#PBS -N osu_container_collective_inter_alltoall_alglock
#PBS -l walltime=02:30:00
#PBS -l place=scatter:excl
#PBS -q normal
#PBS -P personal-haiyen02
#PBS -j oe
#PBS -o logs/osu_container_collective_inter_alltoall_alglock.out

# Isolates the collective-ALGORITHM variable from the transport variable, same
# idea as osu_container_collective_inter_allreduce_alglock.pbs. Network
# transport is UNCHANGED from the baseline container inter-node collective
# script (vader,tcp,self + hsn0 pins) -- this does NOT test UCX/RDMA. The
# only addition is forcing Alltoall onto the pairwise-exchange algorithm via
# OpenMPI's coll_tuned component.
#
#   baseline this script starts from : --mca btl vader,tcp,self
#                                       --mca btl_vader_single_copy_mechanism none
#                                       --mca btl_tcp_if_include hsn0
#                                       --mca oob_tcp_if_include hsn0
#   addition under test               : --mca coll_tuned_use_dynamic_rules 1
#                                        --mca coll_tuned_alltoall_algorithm 2  (pairwise)
#
# IMPORTANT CAVEAT, stated up front rather than discovered after the fact:
# MPI_Alltoall's semantics require every rank to exchange distinct data with
# every other rank within ONE call, regardless of which algorithm schedules
# that exchange. OpenMPI's TCP BTL caches connections for the life of the
# job, so by the time a single Alltoall call returns, the full O(P^2)
# connection set has to exist either way -- pairwise changes the ORDER
# connections are opened in, not the total count. The baseline's root cause
# (ip_local_port_range exhaustion, measured in
# baseline/osu/scripts/collective/inter_node/diagnostics/) is therefore
# expected to still apply at n=4/n=8 even with this change. This script tests
# that expectation rather than assuming it -- if pairwise's staggered
# connection setup keeps instantaneous concurrent connections below the port
# ceiling (plausible if TCP's own connection-establishment handshake overlap
# is what the "storm" framing was really about), the result will say so.
#
# ALG=0 is NOT run here -- it would reproduce the already-collected baseline
# Alltoall data in baseline/osu/results/collective/inter_node/.

cd "$PBS_O_WORKDIR"

module purge
module load libfabric/1.11.0.4.125
module load openmpi/4.1.2-hpe
module load apptainer

SIF=$HOME/scratch/fyp/container/osu/osu_micro_benchmarks.sif
OSU_DIR=/opt/osu-micro-benchmarks-8.0rc/install/libexec/osu-micro-benchmarks/mpi/collective

: "${MODE:?Must pass -v MODE=<weak|strong>}"
: "${NODES:?Must pass -v NODES=<node count>}"
: "${ALG:?Must pass -v ALG=<2|...>}"
: "${REPS:?Must pass -v REPS=<number>}"

BIN="${OSU_DIR}/osu_alltoall"
apptainer exec "$SIF" sh -c "test -x $BIN" \
    || { echo "FATAL: $BIN not found inside $SIF"; exit 1; }

RANKS_PER_NODE=128
NP=$(( NODES * RANKS_PER_NODE ))

ACTUAL_NODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$ACTUAL_NODES" -ne "$NODES" ]; then
    echo "FATAL: Expected $NODES distinct nodes, PBS granted $ACTUAL_NODES."
    exit 1
fi

SLOTS=$(wc -l < "$PBS_NODEFILE")
if [ "$SLOTS" -ne "$NP" ]; then
    echo "FATAL: PBS_NODEFILE has $SLOTS slots but NODES=$NODES implies NP=$NP."
    exit 1
fi

UNEVEN=$(awk '{c[$1]++} END {for (h in c) if (c[h] != 128) print h, c[h]}' "$PBS_NODEFILE")
if [ -n "$UNEVEN" ]; then
    echo "FATAL: uneven ranks per node (expected $RANKS_PER_NODE):"
    echo "$UNEVEN"
    exit 1
fi

case "$MODE" in
  weak)
    MSG=65536
    ;;
  strong)
    TOTAL=8388608
    if [ $(( TOTAL % NP )) -ne 0 ]; then
        echo "FATAL: TOTAL=$TOTAL is not divisible by NP=$NP -- per-rank size would be truncated"
        exit 1
    fi
    MSG=$(( TOTAL / NP ))
    ;;
  *) echo "FATAL: unknown MODE='$MODE' (expected weak|strong)"; exit 1 ;;
esac

REPORT_DIR="collective_alglock/${MODE}/alg${ALG}/n${NODES}_alltoall"
mkdir -p "$REPORT_DIR" logs

BENCH_ARGS=(-f -i 100 -m "${MSG}:${MSG}")

# Baseline transport, unchanged -- plus the forced algorithm.
MPI_CONFIG=(
  -np "$NP"
  --map-by core --bind-to core
  --mca btl vader,tcp,self
  --mca btl_vader_single_copy_mechanism none
  --mca btl_tcp_if_include hsn0
  --mca oob_tcp_if_include hsn0
  --mca orte_base_help_aggregate 0
  --mca opal_common_ucx_opal_mem_hooks 1
  --mca coll_tuned_use_dynamic_rules 1
  --mca coll_tuned_alltoall_algorithm "$ALG"
  -x UCX_LOG_LEVEL=ERROR
)

echo "================================================================="
echo " Container inter-node Alltoall, algorithm locked: MODE=$MODE NODES=$NODES NP=$NP ALG=$ALG MSG=${MSG}B REPS=$REPS "
echo "================================================================="

sort -u "$PBS_NODEFILE" > "${REPORT_DIR}/nodes.txt"
echo "=== nodes used ($ACTUAL_NODES distinct) ==="; cat "${REPORT_DIR}/nodes.txt"
echo "$MSG" > "${REPORT_DIR}/msgsize_bytes.txt"
echo "$NP"  > "${REPORT_DIR}/ranks.txt"
echo "$ALG" > "${REPORT_DIR}/algorithm.txt"

echo "=== ephemeral port range on this node (for comparison with the baseline diagnostic) ==="
cat /proc/sys/net/ipv4/ip_local_port_range | tee "${REPORT_DIR}/port_range.txt"

mpirun "${MPI_CONFIG[@]}" --report-bindings true \
    > "${REPORT_DIR}/bindings.txt" 2>&1 || echo "  (binding capture failed, non-fatal)"

for REP in $(seq 1 "$REPS"); do
    echo "--- Repetition ${REP}/${REPS} ---"
    OUT="${REPORT_DIR}/osu_alltoall_rep${REP}.txt"

    set -x
    mpirun "${MPI_CONFIG[@]}" apptainer exec "$SIF" "$BIN" "${BENCH_ARGS[@]}" > "$OUT" 2>&1
    RC=$?
    set +x

    if [ "$RC" -ne 0 ]; then
        echo "FAILED: MODE=$MODE NODES=$NODES ALG=$ALG rep=$REP (exit $RC)"
        sed 's/^/    /' "$OUT" | head -30
        # "Address already in use" (EADDRINUSE, errno 98) is the exact string
        # the baseline port-exhaustion diagnostic observed and grepped for
        # (scripts/collective/inter_node/diagnostics/port_exhaustion_diag.pbs)
        # -- not EADDRNOTAVAIL, which this cluster's bind() calls do not emit.
        x=$(grep -ci 'Address already in use\|Cannot assign requested address\|EADDRNOTAVAIL' "$OUT"); x=${x:-0}
        echo "  port-error lines in this output: $x"
        exit "$RC"
    fi

    rows=$(grep -cE '^[0-9]' "$OUT")
    if [ "$rows" -lt 1 ]; then
        echo "FATAL: $OUT has no data rows -- benchmark produced no table"
        sed 's/^/    /' "$OUT" | head -20
        exit 1
    fi
    echo "  ok: $rows data row(s) recorded"
done

echo " Container inter-node Alltoall, algorithm locked (MODE=$MODE, NODES=$NODES, ALG=$ALG) Completed Successfully! "
