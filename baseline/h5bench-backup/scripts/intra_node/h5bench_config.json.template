{
  "mpi": {
    "command": "mpirun",
    "configuration": "@MPI_CONFIG@"
  },
  "vol": {},
  "file-system": {
    "lustre": {
      "stripe-count": "4",
      "stripe-size": "1M"
    }
  },
  "directory": "@DIRECTORY@",
  "benchmarks": [
    {
      "benchmark": "write",
      "file": "@DATA_FILE@",
      "configuration": {
        "MEM_PATTERN": "@MEM_PATTERN@",
        "FILE_PATTERN": "@FILE_PATTERN@",
        "NUM_DIMS": "1",
        "DIM_1": "1 M",
        "DIM_2": "1",
        "DIM_3": "1",
        "TIMESTEPS": "5",
        "EMULATED_COMPUTE_TIME_PER_TIMESTEP": "0 s",
        "MODE": "SYNC",
        "COLLECTIVE_DATA": "NO",
        "COLLECTIVE_METADATA": "NO",
        "CSV_FILE": "@CSV_FILE@"
      }
    }
  ]
}
