{
  "mpi": {
    "command": "mpirun",
    "configuration": "-np 256 --map-by ppr:128:node --bind-to core --mca btl ^openib --mca pml ucx --mca orte_base_help_aggregate 0 --mca opal_common_ucx_opal_mem_hooks 1 -x UCX_LOG_LEVEL=ERROR"
  },
  "vol": {},
  "file-system": {
    "lustre": {
      "stripe-count": "4",
      "stripe-size": "1M"
    }
  },
  "directory": "payload/native/dno_myes",
  "benchmarks": [
    {
      "benchmark": "write",
      "file": "h5bench_collective_native_dno_myes.h5",
      "configuration": {
        "MEM_PATTERN": "CONTIG",
        "FILE_PATTERN": "CONTIG",
        "NUM_DIMS": "1",
        "DIM_1": "1 M",
        "DIM_2": "1",
        "DIM_3": "1",
        "TIMESTEPS": "5",
        "EMULATED_COMPUTE_TIME_PER_TIMESTEP": "0 s",
        "MODE": "SYNC",
        "COLLECTIVE_DATA": "NO",
        "COLLECTIVE_METADATA": "YES",
        "CSV_FILE": "write_rep8.csv"
      }
    },
    {
      "benchmark": "read",
      "file": "h5bench_collective_native_dno_myes.h5",
      "configuration": {
        "MEM_PATTERN": "CONTIG",
        "FILE_PATTERN": "CONTIG",
        "READ_OPTION": "FULL",
        "NUM_DIMS": "1",
        "DIM_1": "1 M",
        "DIM_2": "1",
        "DIM_3": "1",
        "TIMESTEPS": "5",
        "EMULATED_COMPUTE_TIME_PER_TIMESTEP": "0 s",
        "MODE": "SYNC",
        "COLLECTIVE_DATA": "NO",
        "COLLECTIVE_METADATA": "YES",
        "CSV_FILE": "read_rep8.csv"
      }
    }
  ]
}
