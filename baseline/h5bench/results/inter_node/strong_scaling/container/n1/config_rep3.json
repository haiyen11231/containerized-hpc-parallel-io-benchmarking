    },
    {
      "benchmark": "read",
      "file": "h5bench_strong_container_n1.h5",
      "configuration": {
        "MEM_PATTERN": "CONTIG",
        "FILE_PATTERN": "CONTIG",
        "READ_OPTION": "FULL",
        "NUM_DIMS": "1",
        "DIM_1": "1048576",
        "DIM_2": "1",
        "DIM_3": "1",
        "TIMESTEPS": "5",
        "EMULATED_COMPUTE_TIME_PER_TIMESTEP": "0 s",
        "MODE": "SYNC",
        "COLLECTIVE_DATA": "NO",
        "COLLECTIVE_METADATA": "NO",
        "CSV_FILE": "read_rep3.csv"
      }
