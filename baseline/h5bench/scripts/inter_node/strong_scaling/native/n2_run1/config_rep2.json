{
  "mpi": {
    "command": "mpirun",
    "configuration": "-np 128 --map-by ppr:64:node --bind-to core --mca btl ^openib --mca pml ucx --mca orte_base_help_aggregate 0 --mca opal_common_ucx_opal_mem_hooks 1 -x UCX_LOG_LEVEL=ERROR"
  },
  "vol": {},
  "file-system": {
    "lustre": {
      "stripe-count": "8",
      "stripe-size": "1M"
    }
  },
  "directory": "payload/native/n2",
  "benchmarks": [
    {
      "benchmark": "write",
      "file": "h5bench_strong_native_n2.h5",
      "configuration": {
        "MEM_PATTERN": "CONTIG",
        "FILE_PATTERN": "CONTIG",
        "NUM_DIMS": "2",
        "DIM_1": "1024",
        "DIM_2": "2048",
        "DIM_3": "1",
        "TIMESTEPS": "10",
        "DELAYED_CLOSE_TIMESTEPS": "0",
        "EMULATED_COMPUTE_TIME_PER_TIMESTEP": "0 s",
        "MODE": "SYNC",
        "COLLECTIVE_DATA": "NO",
        "COLLECTIVE_METADATA": "NO",
        "CSV_FILE": "write_rep2.csv"
      }
    }
  ]
}

