{
  "vol": "none",
  "mpi": {
    "command": "mpirun",
    "ranks": "4"
  },
  "directory": "./h5bench_container_output",
  "file-system": {
    "lustre": {
      "stripe-count": "4",
      "stripe-size": "1M"
    }
  },
  "benchmarks": [
    {
      "benchmark": "write",
      "file": "container_test_data.h5",
      "configuration": {
        "MEM_PATTERN": "CONTIG",
        "FILE_PATTERN": "CONTIG",
        "NUM_PARTICLES": "16 M",
        "TIMESTEPS": "2",
        "MODE": "SYNC",
        "CSV_FILE": "container_write_results.csv"
      }
    },
    {
      "benchmark": "read",
      "file": "container_test_data.h5",
      "configuration": {
        "MEM_PATTERN": "CONTIG",
        "FILE_PATTERN": "CONTIG",
        "NUM_PARTICLES": "16 M",
        "TIMESTEPS": "2",
        "MODE": "SYNC",
        "CSV_FILE": "container_read_results.csv"
      }
    }
  ]
}
