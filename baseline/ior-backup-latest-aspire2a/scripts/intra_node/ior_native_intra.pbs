#!/bin/bash
#PBS -N ior_native_intra
#PBS -l select=1:ncpus=64:mpiprocs=64:mem=32gb
#PBS -l walltime=02:10:00
#PBS -l place=excl
#PBS -q normal
#PBS -P personal-haiyen02
#PBS -j oe
#PBS -o logs/ior_native_intra.out

# Experiment description: Run IOR natively on single node with 64 ranks,
# sweeping transfer size (-t: 1m, 4m) with block size fixed at 64m.
# The stripe count and size are held FIXED at 4 and 1m, respectively,
# and identical between the two combos (MPI-IO + Shared vs POSIX + FPP).

cd "$PBS_O_WORKDIR"

module swap cray-mpich openmpi

IOR_BIN=$HOME/scratch/fyp/native/ior/ior-4.0.0/src/ior
NP=64

# Validate input variables
: "${API:?Must pass -v API=<POSIX|MPIIO> at submission time}"
: "${MODEL:?Must pass -v MODEL=<shared|fpp> at submission time}"

API_LOWER=$(echo "$API" | tr '[:upper:]' '[:lower:]')
FPP_FLAG=""
[ "$MODEL" == "fpp" ] && FPP_FLAG="-F"

API_EXTRA_FLAGS=""
if [ "$API" == "MPIIO" ]; then
    API_EXTRA_FLAGS="-c"
elif [ "$API" == "POSIX" ]; then
    API_EXTRA_FLAGS="-e --posix.odirect"
fi

STRIPE_COUNT=4
STRIPE_SIZE=1m
B=64m
T_SIZES=(1m 4m)

# Ensure leftover per-transfer-size payload dirs are cleaned up
trap 'rm -rf native/${API_LOWER}_${MODEL}_t*' EXIT

REPORT_DIR="native/${API_LOWER}/${MODEL}"
mkdir -p "$REPORT_DIR"

ANY_FAILURE=0
for T in "${T_SIZES[@]}"; do
    echo "---------------------------------------------------"
    echo "Running: API=$API | MODEL=$MODEL | -t $T | -b $B "
    echo "---------------------------------------------------"

    # Each transfer size gets its own freshly-striped payload directory
    PAYLOAD_DIR="native/${API_LOWER}_${MODEL}_t${T}"
    mkdir -p "$PAYLOAD_DIR"
    lfs setstripe -c "$STRIPE_COUNT" -S "$STRIPE_SIZE" "$PAYLOAD_DIR"
    echo "=== Verifying Lustre Striping Layout for $PAYLOAD_DIR ==="
    lfs getstripe "$PAYLOAD_DIR"

    TEST_FILE="${PAYLOAD_DIR}/testfile_${API_LOWER}_${MODEL}_t${T}"
    rm -f "${TEST_FILE}"*

    set -x
    mpirun -np "$NP" \
      --map-by ppr:64:node --bind-to core \
      --mca btl ^openib \
      --mca pml ucx \
      --mca orte_base_help_aggregate 0 \
      --mca opal_common_ucx_opal_mem_hooks 1 \
      -x UCX_LOG_LEVEL=ERROR \
      "$IOR_BIN" \
      -a "$API" $FPP_FLAG \
      -w \
      -t "$T" -b "$B" \
      -m -g -d 5 $API_EXTRA_FLAGS -i 10 \
      -o "$TEST_FILE" \
      > "${REPORT_DIR}/ior_t${T}.txt"
    MPIRUN_EXIT=$?
    set +x

    if [ "$MPIRUN_EXIT" -ne 0 ]; then
        echo "FAILED: API=$API MODEL=$MODEL T=$T (mpirun exit code $MPIRUN_EXIT)"
        ANY_FAILURE=1
    fi

    rm -rf "${PAYLOAD_DIR}"

    sleep 5
done

if [ "$ANY_FAILURE" -eq 1 ]; then
    echo "================================================================="
    echo " Native Intra-Node Sweep (API=$API MODEL=$MODEL) COMPLETED WITH FAILURES -- see FAILED lines above! "
    echo "================================================================="
    exit 1
fi

echo "Completed Successfully! "
