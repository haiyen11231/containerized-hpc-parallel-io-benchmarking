Bootstrap: docker
From: ubuntu:22.04

%post
	# Install GNU C/C++, Make -> compile the benchmark source code
	# Install wget, tar -> download and extract
	# Install libopenmpi-dev & openmpi-bin -> installs Open MPI + development headers needed to compile applications against it.
    apt-get update
    apt-get install -y build-essential wget tar openmpi-bin libopenmpi-dev

    # Download and build IOR.
    cd /opt
    wget https://github.com/hpc/ior/releases/download/4.0.0/ior-4.0.0.tar.gz
    tar xzf ior-4.0.0.tar.gz
    cd ior-4.0.0
    ./configure
    make

    # Clean up
    rm -f /opt/ior-4.0.0.tar.gz
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/ior-4.0.0/src:$PATH
