Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update 
    # due to autoconf old!!!
    apt-get install -y build-essential git automake autoconf libopenmpi-dev openmpi-bin
    cd /opt
    git clone https://github.com/hpc/ior.git
    cd ior
    ./bootstrap
    ./configure
	make
	make install
		
	# Clean up
    cd /opt
    rm -rf ior
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/usr/local/bin:$PATH
    