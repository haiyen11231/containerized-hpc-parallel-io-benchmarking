#!/bin/bash
#PBS -N h5bench_native_collective_recorder
#PBS -l walltime=02:05:00
#PBS -l place=scatter:excl
#PBS -q normal
#PBS -P personal-haiyen02
#PBS -j oe
#PBS -o logs/h5bench_native_collective_recorder.out

# Recorder-instrumented version of baseline/h5bench/scripts/inter_node/
# collective_io/h5bench_native_collective.pbs. This is the centerpiece of the
# h5bench profiling plan (../../GUIDE.md H7): does the container's RESOLVED
# COLLECTIVE_DATA gain (+18.7%, vs native's unresolved +10.3%) correspond to a
# genuinely different two-phase aggregation pattern -- more/larger aggregated
# writes, and mostly intra-node traffic?
#
# Only COLLECTIVE_METADATA=NO is used here (fixed) -- that switch's own effect
# is already established as null (baseline fig3), so a metadata-focused
# Recorder run would spend time on a question already answered. COLL_DATA is
# the one axis that matters: run once per value (NO = dno_mno reference, YES
# = the resolving case) and compare the write-phase trace between them.
#
# REPS=1 deliberately -- Recorder traces are large; this is read for the call
# SEQUENCE, not averaged for statistics (the CSV bandwidth numbers already
# have n=10 from the baseline).

cd "$PBS_O_WORKDIR"
WORKDIR=$(pwd)

module purge
module load libfabric/1.11.0.4.125
module load intel/2022.0.2
module load hdf5/1.12.1-parallel-icc22-ompi4
module swap openmpi/4.1.7-icc24.2.1 openmpi/4.1.2-hpe
module swap intel/2024.2.1 intel/2022.0.2

H5BENCH_DRIVER=$HOME/scratch/fyp/native/h5bench/h5bench/build/install/bin/h5bench
TEMPLATE="${WORKDIR}/h5bench_config_collective.json.template"
RECORDER_LIB=$HOME/scratch/fyp/native/recorder/Recorder/install/lib/librecorder.so

[ -r "$RECORDER_LIB" ] || { echo "FATAL: $RECORDER_LIB not readable -- build Recorder first (profiling/SETUP.md section 5)"; exit 1; }
echo "  recorder lib linked MPI: $(ldd "$RECORDER_LIB" 2>/dev/null | grep -oE 'libmpi[^ ]*\.so[^ ]*' | head -1)"
echo "  (want libmpi.so.40 = OpenMPI, NOT libmpi_cray.so.12)"

: "${COLL_DATA:?Must pass -v COLL_DATA=<YES|NO> at submission time}"
REPS=1
COLL_META=NO

NODE_COUNT=2
NP=$((NODE_COUNT * 128))
ACTUAL_NODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$ACTUAL_NODES" -ne "$NODE_COUNT" ]; then
    echo "FATAL: Expected $NODE_COUNT node(s), PBS granted $ACTUAL_NODES."
    exit 1
fi

# Same transport as the baseline native collective script -- Recorder's
# question is about the HDF5/MPI-IO call pattern, not transport, so nothing
# else should differ from the run that produced the 1.80/1.67 GiB/s numbers.
MPI_CONFIG="-np ${NP} --map-by ppr:128:node --bind-to core --mca btl ^openib --mca pml ucx --mca orte_base_help_aggregate 0 --mca opal_common_ucx_opal_mem_hooks 1 -x UCX_LOG_LEVEL=ERROR -x LD_PRELOAD=${RECORDER_LIB} -x RECORDER_MPI_TRACING=1 -x RECORDER_MPIIO_TRACING=1 -x RECORDER_DEBUG_LEVEL=0"

COMBO="d$(echo "$COLL_DATA" | tr '[:upper:]' '[:lower:]')_m$(echo "$COLL_META" | tr '[:upper:]' '[:lower:]')"

PAYLOAD_DIR="${WORKDIR}/payload/native/${COMBO}"
REPORT_DIR="${WORKDIR}/native/${COMBO}"
TRACEBASE="${WORKDIR}/recorder-traces/native/${COMBO}_${PBS_JOBID}"
mkdir -p "$PAYLOAD_DIR" "$REPORT_DIR" "$TRACEBASE" logs

lfs setstripe -c 4 -S 1m "$PAYLOAD_DIR"
echo "=== Lustre striping on $PAYLOAD_DIR ==="
lfs getstripe "$PAYLOAD_DIR"

DATA_FILE_NAME="h5bench_collective_native_recorder_${COMBO}.h5"
trap 'rm -f "${PAYLOAD_DIR}/${DATA_FILE_NAME}"' EXIT

echo "================================================================="
echo " Native Collective I/O, Recorder-instrumented: COLLECTIVE_DATA=$COLL_DATA (METADATA fixed NO) NODES=$NODE_COUNT NP=$NP "
echo "================================================================="

JSON="${REPORT_DIR}/config.json"
sed -e "s|@MPI_CONFIG@|${MPI_CONFIG}|" \
    -e "s|@COLL_DATA@|${COLL_DATA}|" \
    -e "s|@COLL_META@|${COLL_META}|" \
    -e "s|@DIRECTORY@|${PAYLOAD_DIR}|" \
    -e "s|@DATA_FILE@|${DATA_FILE_NAME}|" \
    -e "s|@WRITE_CSV@|write_rep1.csv|" \
    -e "s|@READ_CSV@|read_rep1.csv|" \
    "$TEMPLATE" > "$JSON"

python3 -m json.tool "$JSON" > /dev/null \
    || { echo "FATAL: generated $JSON is not valid JSON"; exit 1; }
if grep -q '@[A-Z_]*@' "$JSON"; then
    echo "FATAL: unsubstituted placeholder left in $JSON:"; grep -n '@[A-Z_]*@' "$JSON"; exit 1
fi

rm -f "${PAYLOAD_DIR}/${DATA_FILE_NAME}"

# Recorder writes its trace into the CURRENT WORKING DIRECTORY at the time the
# ranks call MPI_Init. h5bench's driver inherits whatever CWD it is invoked
# from, so cd into the dedicated trace dir FIRST -- every path above is
# already absolute, so nothing else breaks from the directory change.
cd "$TRACEBASE"
DRIVER_LOG="${REPORT_DIR}/driver.log"
set -x
time "$H5BENCH_DRIVER" -a -d "$JSON" > "$DRIVER_LOG" 2>&1
H5BENCH_EXIT=$?
set +x
cd "$WORKDIR"
cat "$DRIVER_LOG"

if [ "$H5BENCH_EXIT" -ne 0 ]; then
    echo "FAILED: COLL_DATA=$COLL_DATA (h5bench exit $H5BENCH_EXIT)"
    exit "$H5BENCH_EXIT"
fi

echo ""
echo "=== what did Recorder produce? ==="
find "$TRACEBASE" -maxdepth 2 | head -20 | sed 's/^/  /'
echo "  size: $(du -sh "$TRACEBASE" 2>/dev/null | awk '{print $1}')"
if [ -z "$(find "$TRACEBASE" -type f 2>/dev/null | head -1)" ]; then
    echo "FATAL: no trace files -- LD_PRELOAD likely did not reach the ranks"
    exit 1
fi

RI=$HOME/scratch/fyp/native/recorder/Recorder/install

# The trace actually lands two levels below TRACEBASE, in a directory named
# "<timestamp>-<host>-<user>-<binary>-<pid>" -- one such directory per h5bench
# phase (h5bench_write, h5bench_read), each containing recorder.dat directly.
# An earlier version of this script searched for a directory just named
# "*recorder*" and matched the date-stamped PARENT directory instead, one
# level too shallow -- recorder-summary/recorder2text then silently failed to
# detect the combined-file format and segfaulted dereferencing a NULL FILE*
# (assert() is compiled out in this build, so the format-mismatch assertion
# never fires; see tools/reader.c check_version()). Finding recorder.dat
# itself and taking its dirname is unambiguous and avoids that failure mode.
WRITE_TRACEDIR=$(find "$TRACEBASE" -type f -name 'recorder.dat' -path '*h5bench_write*' 2>/dev/null | head -1 | xargs -r dirname)
if [ -z "$WRITE_TRACEDIR" ]; then
    echo "FATAL: no recorder.dat found under an h5bench_write directory in $TRACEBASE"
    find "$TRACEBASE" -name 'recorder.dat' 2>/dev/null | sed 's/^/  found instead: /'
    exit 1
fi
echo "  write-phase trace dir: $WRITE_TRACEDIR"

echo ""
echo "=== recorder-summary (write phase -- what H7 is about) ==="
"$RI/bin/recorder-summary" "$WRITE_TRACEDIR" > "${REPORT_DIR}/recorder_summary.txt" 2>&1
cat "${REPORT_DIR}/recorder_summary.txt"

echo ""
echo "=== recorder2text (the call sequence H7 actually needs) ==="
# recorder2text writes its output into <tracedir>/_text/<rank>.txt -- it does
# NOT take a separate output-directory argument despite some docs implying it
# does; verified empirically against this build.
"$RI/bin/recorder2text" "$WRITE_TRACEDIR" > "${REPORT_DIR}/recorder2text.log" 2>&1
TEXTDIR="${WRITE_TRACEDIR}/_text"
if [ -d "$TEXTDIR" ]; then
    echo "  text output: $TEXTDIR"
    echo "  --- MPI-IO write call counts, independent vs collective (what H7 reads) ---"
    # Independent (MPI_File_write_at) vs collective (MPI_File_write_at_all) is
    # exactly the distinction H7 is testing -- COLL_DATA=NO should show only
    # the former, COLL_DATA=YES should show the latter engage instead.
    grep -rhoE 'MPI_File_write_at[a-z_]*' "$TEXTDIR" 2>/dev/null | sort | uniq -c | sort -rn | sed 's/^/    /'
else
    echo "FATAL: recorder2text did not produce $TEXTDIR"
    tail -15 "${REPORT_DIR}/recorder2text.log" | sed 's/^/  /'
    exit 1
fi

echo ""
echo " Native collective I/O Recorder run (COLL_DATA=$COLL_DATA) Completed Successfully! "
