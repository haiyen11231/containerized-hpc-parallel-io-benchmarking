#!/bin/bash
#PBS -N h5bench_native_scaling_darshan
#PBS -l walltime=02:05:00
#PBS -l place=scatter:excl
#PBS -q normal
#PBS -P personal-haiyen02
#PBS -j oe
#PBS -o logs/h5bench_native_scaling_darshan.out

# Darshan-instrumented version of the baseline weak/strong inter-node scaling
# scripts, parametrized by MODE so one script covers both. Tests H5 (weak
# scaling's plateau is shared Lustre saturation, not a container limit) and
# H6 (strong scaling's efficiency collapse is overhead amortization) --
# ../../GUIDE.md. Only the 1-node and 8-node points are instrumented, per the
# plan's experiment design (rows 9-16).
#
# Path A (POSIX-only, DARSHAN_MOD_ENABLE=POSIX) -- same reasoning as the
# intra script: H5/H6 are both POSIX time-share counters. DARSHAN_ENABLE_NONMPI
# is NOT set -- see h5bench_native_intra_darshan.pbs for why (it causes a real
# double-initialization against h5bench's own MPI_Init that silently drops all
# POSIX records, confirmed empirically, not a theoretical concern).

cd "$PBS_O_WORKDIR"

module purge
module load libfabric/1.11.0.4.125
module load intel/2022.0.2
module load hdf5/1.12.1-parallel-icc22-ompi4
module swap openmpi/4.1.7-icc24.2.1 openmpi/4.1.2-hpe
module swap intel/2024.2.1 intel/2022.0.2
module load darshan/3.4.6

H5BENCH_DRIVER=$HOME/scratch/fyp/native/h5bench/h5bench/build/install/bin/h5bench
DARSHAN_LIB=$HOME/scratch/fyp/native/darshan/darshan/install/lib/libdarshan.so

[ -r "$DARSHAN_LIB" ] || { echo "FATAL: $DARSHAN_LIB not readable"; exit 1; }

: "${MODE:?Must pass -v MODE=<weak|strong> at submission time}"
: "${NODE_COUNT:?Must pass -v NODE_COUNT=<1|8> at submission time}"
: "${REPS:?Must pass -v REPS=<number> at submission time}"

case "$MODE" in
  weak|strong) ;;
  *) echo "FATAL: unknown MODE='$MODE' (expected weak|strong)"; exit 1 ;;
esac
TEMPLATE="h5bench_config_${MODE}.json.template"

NP=$((NODE_COUNT * 128))
ACTUAL_NODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$ACTUAL_NODES" -ne "$NODE_COUNT" ]; then
    echo "FATAL: Expected $NODE_COUNT node(s), PBS granted $ACTUAL_NODES."
    exit 1
fi

MPI_CONFIG="-np ${NP} --map-by ppr:128:node --bind-to core --mca btl ^openib --mca pml ucx --mca orte_base_help_aggregate 0 --mca opal_common_ucx_opal_mem_hooks 1 -x UCX_LOG_LEVEL=ERROR -x LD_PRELOAD=${DARSHAN_LIB} -x DARSHAN_MOD_ENABLE=POSIX"

if [ "$MODE" = "strong" ]; then
    TOTAL_PARTICLES=$(( 128 * 1024 * 1024 ))
    if [ $(( TOTAL_PARTICLES % NP )) -ne 0 ]; then
        echo "FATAL: TOTAL_PARTICLES ($TOTAL_PARTICLES) not divisible by NP ($NP)"
        exit 1
    fi
    DIM_1=$(( TOTAL_PARTICLES / NP ))
fi

PAYLOAD_DIR="payload/native/${MODE}/n${NODE_COUNT}"
REPORT_DIR="native/${MODE}/n${NODE_COUNT}"
LOGDIR="darshan-logs/native/${MODE}/n${NODE_COUNT}"
mkdir -p "$PAYLOAD_DIR" "$REPORT_DIR" "$LOGDIR" logs

lfs setstripe -c 4 -S 1m "$PAYLOAD_DIR"
echo "=== Lustre striping on $PAYLOAD_DIR ==="
lfs getstripe "$PAYLOAD_DIR"

DATA_FILE_NAME="h5bench_${MODE}_native_darshan_n${NODE_COUNT}.h5"
trap 'rm -f "${PAYLOAD_DIR}/${DATA_FILE_NAME}"' EXIT

echo "================================================================="
echo " Native ${MODE} scaling, Darshan-instrumented: NODES=$NODE_COUNT NP=$NP ${DIM_1:+DIM_1=$DIM_1} REPS=$REPS "
echo "================================================================="

for REP in $(seq 1 "$REPS"); do
    echo "--- Repetition ${REP}/${REPS} ---"

    DLOG="${LOGDIR}/n${NODE_COUNT}_rep${REP}_${PBS_JOBID}.darshan"
    rm -f "$DLOG"
    RUN_MPI_CONFIG="${MPI_CONFIG} -x DARSHAN_LOGFILE=${DLOG}"

    JSON="${REPORT_DIR}/config_rep${REP}.json"
    SED_ARGS=(
      -e "s|@MPI_CONFIG@|${RUN_MPI_CONFIG}|"
      -e "s|@DIRECTORY@|${PAYLOAD_DIR}|"
      -e "s|@DATA_FILE@|${DATA_FILE_NAME}|"
      -e "s|@WRITE_CSV@|write_rep${REP}.csv|"
      -e "s|@READ_CSV@|read_rep${REP}.csv|"
    )
    [ "$MODE" = "strong" ] && SED_ARGS+=(-e "s|@DIM_1@|${DIM_1}|")
    sed "${SED_ARGS[@]}" "$TEMPLATE" > "$JSON"

    python3 -m json.tool "$JSON" > /dev/null \
        || { echo "FATAL: generated $JSON is not valid JSON"; exit 1; }
    if grep -q '@[A-Z_]*@' "$JSON"; then
        echo "FATAL: unsubstituted placeholder left in $JSON:"; grep -n '@[A-Z_]*@' "$JSON"; exit 1
    fi

    rm -f "${PAYLOAD_DIR}/${DATA_FILE_NAME}"

    DRIVER_LOG="${REPORT_DIR}/driver_rep${REP}.log"
    set -x
    time "$H5BENCH_DRIVER" -a -d "$JSON" > "$DRIVER_LOG" 2>&1
    H5BENCH_EXIT=$?
    set +x
    cat "$DRIVER_LOG"

    if [ "$H5BENCH_EXIT" -ne 0 ]; then
        echo "FAILED: MODE=$MODE NODES=$NODE_COUNT rep=$REP (h5bench exit $H5BENCH_EXIT)"
        exit "$H5BENCH_EXIT"
    fi

    if [ ! -s "$DLOG" ]; then
        echo "FATAL: no Darshan log written to $DLOG"
        exit 1
    fi

    PARSED="${REPORT_DIR}/darshan_rep${REP}.parsed"
    # Retry parse+count up to 3x before declaring FATAL -- see
    # h5bench_native_intra_darshan.pbs for the Lustre read-after-write
    # timing lag this guards against (confirmed on a prior full run).
    POSIX_N=0
    for ATTEMPT in 1 2 3; do
        darshan-parser "$DLOG" > "$PARSED" 2>/dev/null \
            || { echo "FATAL: darshan-parser failed on $DLOG"; exit 1; }
        POSIX_N=$(grep -cP '^POSIX\t' "$PARSED" 2>/dev/null); POSIX_N=${POSIX_N:-0}
        [ "$POSIX_N" -gt 0 ] && break
        echo "  rep${REP}: attempt ${ATTEMPT} saw 0 POSIX counter lines -- retrying in 3s"
        sleep 3
    done
    echo "  rep${REP}: darshan log $(ls -lh "$DLOG" | awk '{print $5}'), $POSIX_N POSIX counter lines"
    [ "$POSIX_N" -gt 0 ] || { echo "FATAL: Darshan log parsed but has no POSIX counters after 3 attempts"; exit 1; }
done

echo " Native ${MODE} scaling Darshan run (NODES=$NODE_COUNT) Completed Successfully! "
