#!/bin/bash
#PBS -N h5bench_native_intra_darshan
#PBS -l walltime=02:10:00
#PBS -l place=excl
#PBS -q normal
#PBS -P personal-haiyen02
#PBS -j oe
#PBS -o logs/h5bench_native_intra_darshan.out

cd "$PBS_O_WORKDIR"

module purge
module load libfabric/1.11.0.4.125
module load intel/2022.0.2
module load openmpi/4.1.2-hpe

export LD_LIBRARY_PATH=$HOME/scratch/fyp/native/hdf5/hdf5-1.10.7/build/install/lib:$LD_LIBRARY_PATH
export PATH=/app/apps/darshan/3.4.6/bin:$PATH

H5BENCH_DRIVER=$HOME/scratch/fyp/native/h5bench/h5bench/build_hdf5_1107/install/bin/h5bench
TEMPLATE=h5bench_config.json.template
DARSHAN_LIB=$HOME/scratch/fyp/native/darshan/darshan/install/lib/libdarshan.so

[ -r "$DARSHAN_LIB" ] || { echo "FATAL: $DARSHAN_LIB not readable"; exit 1; }

: "${MEM_PATTERN:?Must pass -v MEM_PATTERN=<CONTIG|INTERLEAVED> at submission time}"
: "${FILE_PATTERN:?Must pass -v FILE_PATTERN=<CONTIG|INTERLEAVED> at submission time}"

NODE_COUNT=1
NP=$((NODE_COUNT * 64))

# Darshan preload LD_PRELOAD/DARSHAN_* are exported via -x so every rank inherits them, not just rank 0.
MPI_CONFIG="-np ${NP} --map-by ppr:64:node --bind-to core --mca btl ^openib --mca pml ucx --mca orte_base_help_aggregate 0 --mca opal_common_ucx_opal_mem_hooks 1 -x UCX_LOG_LEVEL=ERROR -x LD_PRELOAD=${DARSHAN_LIB} -x DARSHAN_MOD_ENABLE=POSIX"

MEM_LOWER=$(echo "$MEM_PATTERN" | tr '[:upper:]' '[:lower:]')
FILE_LOWER=$(echo "$FILE_PATTERN" | tr '[:upper:]' '[:lower:]')
COMBO="${MEM_LOWER}_${FILE_LOWER}"

PAYLOAD_DIR="payload/native/${COMBO}"
REPORT_DIR="native/${COMBO}"
LOGDIR="darshan-logs/native/${COMBO}"
mkdir -p "$PAYLOAD_DIR" "$REPORT_DIR" "$LOGDIR" logs

lfs setstripe -c 4 -S 1m "$PAYLOAD_DIR"
echo "=== Lustre striping on $PAYLOAD_DIR ==="
lfs getstripe "$PAYLOAD_DIR"

DATA_FILE_NAME="h5bench_intra_native_darshan_${COMBO}.h5"
trap 'rm -f "${PAYLOAD_DIR}/${DATA_FILE_NAME}"' EXIT

DLOG="${LOGDIR}/${COMBO}_${PBS_JOBID}.darshan"
rm -f "$DLOG"
RUN_MPI_CONFIG="${MPI_CONFIG} -x DARSHAN_LOGFILE=${DLOG}"

JSON="${REPORT_DIR}/config.json"
sed -e "s|@MPI_CONFIG@|${RUN_MPI_CONFIG}|" \
    -e "s|@DIRECTORY@|${PAYLOAD_DIR}|" \
    -e "s|@DATA_FILE@|${DATA_FILE_NAME}|" \
    -e "s|@MEM_PATTERN@|${MEM_PATTERN}|" \
    -e "s|@FILE_PATTERN@|${FILE_PATTERN}|" \
    -e "s|@CSV_FILE@|write.csv|" \
    "$TEMPLATE" > "$JSON"

python3 -m json.tool "$JSON" > /dev/null \
    || { echo "FATAL: generated $JSON is not valid JSON"; exit 1; }
if grep -q '@[A-Z_]*@' "$JSON"; then
    echo "FATAL: unsubstituted placeholder left in $JSON:"; grep -n '@[A-Z_]*@' "$JSON"; exit 1
fi

rm -f "${PAYLOAD_DIR}/${DATA_FILE_NAME}"

DRIVER_LOG="${REPORT_DIR}/driver.log"
set -x
time "$H5BENCH_DRIVER" -a -d "$JSON" > "$DRIVER_LOG" 2>&1
H5BENCH_EXIT=$?
set +x
cat "$DRIVER_LOG"

if [ "$H5BENCH_EXIT" -ne 0 ]; then
    echo "FAILED: MEM=$MEM_PATTERN FILE=$FILE_PATTERN (h5bench exit $H5BENCH_EXIT)"
    exit "$H5BENCH_EXIT"
fi

if [ ! -s "$DLOG" ]; then
    echo "FATAL: no Darshan log written to $DLOG -- LD_PRELOAD likely did not reach the ranks"
    exit 1
fi

PARSED="${REPORT_DIR}/darshan.parsed"
POSIX_N=0
for ATTEMPT in 1 2 3; do
    darshan-parser "$DLOG" > "$PARSED" 2>/dev/null \
        || { echo "FATAL: darshan-parser failed on $DLOG"; exit 1; }
    POSIX_N=$(grep -cP '^POSIX\t' "$PARSED" 2>/dev/null); POSIX_N=${POSIX_N:-0}
    [ "$POSIX_N" -gt 0 ] && break
    echo "  attempt ${ATTEMPT} saw 0 POSIX counter lines -- retrying in 3s"
    sleep 3
done
echo "  darshan log $(ls -lh "$DLOG" | awk '{print $5}'), $POSIX_N POSIX counter lines"
[ "$POSIX_N" -gt 0 ] || { echo "FATAL: Darshan log parsed but has no POSIX counters after 3 attempts"; exit 1; }

echo " Native intra-node Darshan run (MEM=$MEM_PATTERN FILE=$FILE_PATTERN) Completed Successfully! "
